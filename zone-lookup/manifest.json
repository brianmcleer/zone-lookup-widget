{
  "name": "zone-lookup",
  "type": "widget",
  "version": "1.5.0",
  "exbVersion": "1.21.0",
  "author": "Brian McLeer",
  "description": "Address-based zone lookup. Geocodes an entered address, finds the configured zone polygon it falls within, and renders a developer-defined HTML template populated with that zone's attributes. Generic point-in-polygon use cases: council districts, polling places, school boundaries, service areas, etc.",
  "copyright": "City of Grand Junction, CO",
  "license": "Apache-2.0",
  "properties": {
    "supportMultipleInstances": true,
    "hasLocale": true,
    "flexibleLayout": true
  },
  "dependency": [
    "jimu-arcgis"
  ],
  "translatedLocales": [
    "en",
    "ar",
    "bg",
    "bs",
    "ca",
    "cs",
    "da",
    "de",
    "el",
    "es",
    "et",
    "fi",
    "fr",
    "he",
    "hr",
    "hu",
    "id",
    "it",
    "ja",
    "ko",
    "lt",
    "lv",
    "no",
    "nl",
    "pl",
    "pt-br",
    "pt-pt",
    "ro",
    "ru",
    "sk",
    "sl",
    "sr",
    "sv",
    "th",
    "tr",
    "zh-cn",
    "uk",
    "vi",
    "zh-hk",
    "zh-tw"
  ],
  "i18nMessages": {
    "_widgetLabel": "Zone Lookup"
  },
  "defaultSize": {
    "width": 400,
    "height": 620
  }
}
