{
  // VS-only type check (WIDGETHANDOFF Section 12, item 3 — Mode B, self-contained).
  // Inert to the webpack build; webpack is the only type authority.
  // Mode B because VS reports IDE1100 "Access to the path ...node_modules... is denied"
  // on this install (pnpm junctions unreadable), so no baseUrl/paths into node_modules.
  "compilerOptions": {
    "noEmit": true,
    "target": "ESNext",
    "module": "ESNext",
    "moduleResolution": "Node",
    "types": [],
    // Also stop VS from scanning any @types directories at all - closes the
    // last path to @types/react through the unreadable pnpm junctions.
    "typeRoots": [],
    "strict": false,
    "skipLibCheck": true,
    "lib": [ "ESNext", "DOM", "DOM.Iterable" ],
    // Classic JSX, no jsxImportSource — "react-jsx" makes VS resolve
    // @emotion/react/jsx-runtime through the pnpm junction and die on the
    // access-denied @types/react/jsx-runtime.d.ts (the jsx-runtime trap).
    "jsx": "react",
    "allowJs": false,
    "esModuleInterop": true,
    "forceConsistentCasingInFileNames": true
  },
  "exclude": [ "node_modules", ".vs" ],
  "include": [ "src/**/*.ts", "src/**/*.tsx", "src/**/*.d.ts" ]
}